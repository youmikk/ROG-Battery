        .parent(page_set)
        .position((140, 176))
        .size((170, 200))
        .collection(
            TTL_CHOICES
                .iter()
                .map(|s| {
                    if *s == 0 {
                        "每次都读设备".to_string()
                    } else {
                        format!("{s} 秒")
                    }
                })
                .collect(),
        )
        .build(&mut cb_ttl)
        .map_err(|e| format!("TTL 下拉：{e}"))?;
    cb_ttl.set_selection(Some(nearest_index(&TTL_CHOICES, cfg.cache_ttl_sec)));

    let mut btn_save = nwg::Button::default();
