    // 用户改一档不影响别的档，所以四档各自独立的「应用」。
    let mut lbl_perf_dpi = nwg::Label::default();
    nwg::Label::builder()
        .text("DPI 档位")
        .parent(page_perf)
        .position((24, 66))
        .size((90, 24))
        .background_color(Some(PAGE_BG))
