    // 只列出本型号真的支持的六个模式。
    // Rainbow(3) 和 Comet(5) 会被设备静默回落到 ColorCycle ——
    // 列出来等于骗用户，不如不列。
    const LIGHT_MODES: [(u8, &str); 6] = [
        (0, "Static（常亮）"),
        (1, "Breathing（呼吸）"),
        (2, "ColorCycle（循环变色）"),
        (4, "React（响应）"),
        (6, "BatteryState（电量指示）"),
        (240, "Off（关灯）"),
    ];

    let mut cb_light_mode = nwg::ComboBox::default();
    nwg::ComboBox::builder()
        .parent(page_light)
        .position((120, 22))
