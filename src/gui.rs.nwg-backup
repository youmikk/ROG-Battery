    let mut btn_refresh = nwg::Button::default();
    nwg::Button::builder()
        .text("立即刷新")
        .parent(page_bat)
        .position((24, 134))
        .size((110, 34))
        .build(&mut btn_refresh)
        .map_err(|e| format!("刷新按钮：{e}"))?;

    // 历史曲线：没有控件，直接在电量页的 `Tab` 窗口上挂子类过程自己画
    // （`chart.rs` 顶部解释了为什么不用 Frame / ExternCanvas）。
    //
    // 这里**不建任何控件**：`WM_PAINT` 的落点就是 `page_bat` 本身，
    // 绘图区在 `chart::area()`（24,186 起的 660×200），
    // 与下方没有任何控件重叠（这一页最靠下的是 134 处的刷新按钮）。
    //
    // 处理器只做「读现成点集 + 画」，点集由后台线程算好塞进 `shared`。
    let h_page_bat = page_bat.handle.clone();

    // ── 设置页（tab 4）──────────────────────────────────────
    let page_set = &pages[4];

    let mut chk_tray = nwg::CheckBox::default();
    nwg::CheckBox::builder()
        .text("在系统托盘显示图标")
        .parent(page_set)
        .position((24, 30))
        .size((320, 26))
        // 必须显式给白底。`Tab` 的窗口类背景刷是 `COLOR_BTNFACE`（#F0F0F0），
        // 不设这个就会在文字周围露出一块灰方块
        // （`docs\nwg-gotchas.md` 第 1 节：`Label` 同样的坑，`CheckBox` 也一样）。
        .background_color(Some(PAGE_BG))
        .check_state(bool_to_check(cfg.tray_enabled))
        .build(&mut chk_tray)
        .map_err(|e| format!("托盘开关：{e}"))?;

    let mut chk_close = nwg::CheckBox::default();
    nwg::CheckBox::builder()
        .text("关闭窗口时最小化到托盘（不退出）")
        .parent(page_set)
        .position((24, 64))
        .size((400, 26))
        .background_color(Some(PAGE_BG))
        .check_state(bool_to_check(cfg.close_to_tray))
        .build(&mut chk_close)
        .map_err(|e| format!("关闭行为开关：{e}"))?;

    // 开机自启：状态来自注册表 / WinRT，**不能自己猜**。
    //
    // `autostart::state()` 永不返回 Err（读不到就是 `Unknown`），所以这里
    // 不会因为查状态失败而挡住整个界面。
    let (auto_state, auto_path) = crate::autostart::state();

    let mut chk_autostart = nwg::CheckBox::default();
    nwg::CheckBox::builder()
        .text("开机自动启动")
        .parent(page_set)
        .position((24, 98))
        .size((400, 26))
        .background_color(Some(PAGE_BG))
        .check_state(bool_to_check(auto_state.is_enabled()))
        .build(&mut chk_autostart)
        .map_err(|e| format!("自启开关：{e}"))?;

    // 自启的真实状态显示在勾选框右边。
    //
    // 用**短名**而不是 `AutoStartState::describe()`：describe 里最长的一句是
    // 「已被用户关闭（需在系统设置里手动开启）」，23 个字放不进 275 px。
    // 完整解释留给下面的 `lbl_hint`（点了才有）。
    //
    // 把「走哪条路」也带上：绿色版写注册表、MSIX 包内走 WinRT StartupTask，
    // 出问题时这是第一个要区分的信息。
    let mut lbl_auto_state = nwg::Label::default();
    nwg::Label::builder()
        .text(&format!(
            "当前：{}（{}）",
            auto_state_short(auto_state),
            auto_path.short()
        ))
        .parent(page_set)
        .position((430, 98))
        .size((275, 26))
        .background_color(Some(PAGE_BG))
        .build(&mut lbl_auto_state)
        .map_err(|e| format!("自启状态标签：{e}"))?;

    let mut lbl_refresh = nwg::Label::default();
    nwg::Label::builder()
        .text("后台刷新间隔")
        .parent(page_set)
        .position((24, 142))
        .size((110, 26))
        .background_color(Some(PAGE_BG))
        .build(&mut lbl_refresh)
        .map_err(|e| format!("刷新间隔标签：{e}"))?;

    let mut cb_refresh = nwg::ComboBox::default();
    nwg::ComboBox::builder()
        .parent(page_set)
        .position((140, 140))
        .size((170, 200))
        .collection(REFRESH_CHOICES.iter().map(|s| format!("{s} 秒")).collect())
        .build(&mut cb_refresh)
        .map_err(|e| format!("刷新间隔下拉：{e}"))?;
    cb_refresh.set_selection(Some(nearest_index(&REFRESH_CHOICES, cfg.refresh_interval_sec)));

    let mut lbl_ttl = nwg::Label::default();
    nwg::Label::builder()
        .text("快照缓存有效期")
        .parent(page_set)
        .position((24, 178))
        .size((110, 26))
        .background_color(Some(PAGE_BG))
