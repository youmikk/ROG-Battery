        dpi_titles.push(lb);

        let mut ti = nwg::TextInput::default();
        nwg::TextInput::builder()
            .text("")
            .parent(page_perf)
            .position((165, y))
            .size((90, 26))
            .limit(5)
            .build(&mut ti)
            .map_err(|e| format!("DPI 档 {i} 输入框：{e}"))?;
        dpi_inputs.push(ti);

        let mut lb2 = nwg::Label::default();
        nwg::Label::builder()
            .text("当前 --")
            .parent(page_perf)
            .position((275, y + 4))
            .size((200, 24))
            .background_color(Some(PAGE_BG))
            .build(&mut lb2)
            .map_err(|e| format!("DPI 档 {i} 当前值：{e}"))?;
        dpi_nows.push(lb2);

        let mut bt = nwg::Button::default();
        nwg::Button::builder()
            .text("应用")
            .parent(page_perf)
            .position((485, y))
            .size((80, 26))
            .build(&mut bt)
            .map_err(|e| format!("DPI 档 {i} 应用按钮：{e}"))?;
        dpi_apply.push(bt);
    }

    // —— 当前档位（哪个 DPI 档生效）——
