        .map_err(|e| format!("DPI 标签：{e}"))?;

    let mut dpi_inputs: Vec<nwg::TextInput> = Vec::new();
    let mut dpi_titles: Vec<nwg::Label> = Vec::new();
    let mut dpi_nows: Vec<nwg::Label> = Vec::new();
    let mut dpi_apply: Vec<nwg::Button> = Vec::new();
    for i in 0..proto::DPI_STAGES {
        let y = 60 + (i as i32) * 34;

        let mut lb = nwg::Label::default();
        nwg::Label::builder()
            .text(&format!("档 {}", i + 1))
            .parent(page_perf)
            .position((120, y + 4))
            .size((40, 24))
