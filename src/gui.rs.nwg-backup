//! 图形界面（native-windows-gui 1.0.13）。
//!
//! # 两条铁律
//!
//! 1. **HID 操作绝不在 GUI 线程上跑**。鼠标休眠时一次 MISS 要等满 1200ms 超时，
//!    在 GUI 线程上跑会让窗口直接假死（用户会以为程序崩了）。
//!    做法：后台线程独占设备句柄干活，读完通过 [`nwg::Notice`] 唤醒 GUI 线程，
//!    数据用 [`Arc<Mutex<Shared>>`] 交接。
//!
//! 2. **所有页面控件 parent 到 [`nwg::Tab`]，不是 [`nwg::Window`]**。
//!    `Tab` 是真正的子窗口（类名 `NWG_TAB`，`WS_CHILD | WS_CLIPCHILDREN`），
//!    `Tab::init` 会把它 resize 成 tab 视图大小并把所有 tab 隐藏。挂到 Window 上的
//!    控件会挡在 Tab 容器下面（z-order 在后），看起来就像「控件没画出来」。
//!
//! # 范围
//!
//! 第一批：主窗口 + 五标签 + 电量页 + 设置页。
//! 第二批：性能页 / 灯光页 / 按键页（全部经 [`crate::ops`]，GUI 里没有第二套写逻辑）。
//!
//! # 写操作为什么要走队列
//!
//! GUI 线程不能碰 HID（铁律 1）。但设置页面上的按钮点下去必须真的写设备，
//! 于是设计成：**GUI 线程只往队列里塞一个 [`Cmd`]，后台线程取出来执行**。
//!
//! 这样写有三个好处：
//! 1. 写操作天然串行 —— 后台线程一次只干一件事，不会两个 setter 交叉写同一寄存器
//!    （这会把设备写坏，正是文档第 5 节那次事故的形状）。
//! 2. 写的过程中 GUI 还能响应重绘（写一次要 1.4 秒）。
//! 3. 写完之后后台线程顺手读一次新状态，界面自动跟上，不需要 GUI 侧再触发一次刷新。
//!
//! GUI 线程提交命令后立刻切到 [`Status::Busy`]，按钮置灰，直到后台线程回报结果。
//!
//! # 为什么没有定时器
//!
//! 骨架里用了 `AnimationTimer`，这里**刻意不用**：刷新节奏由后台线程自己控制
//! （它 sleep 在 `Condvar` 上，被「立即刷新」和「改间隔」唤醒）。
//! 再加一个定时器只会让「谁触发刷新」有两个来源，出问题时更难定位。
//!
//! # 已踩过的坑（写在这里省下一次试错）
//!
//! - `TabsContainer` 高度必须给够（≥340），给 60 会导致标签条完全不渲染。
//! - 控件类名是 `TabsContainer` + `Tab`，**不是** `Tabs`。
//! - `TrayNotification` 的 parent 必须是 `MessageWindow`，不能是普通 `Window`。
//! - `TrayNotification::build` 时 icon 为 `None` 会 **panic**
//!   （`src\controls\tray_notification.rs:370`）。本项目用 `include_bytes!` 编进 exe 的
//!   `assets\tray.ico`，**且不能给 `.size()`** —— 那条路走 WIC image factory，
//!   ico 里 256×256 的 PNG 条目 WIC 不认，报 `Failed to create a image factory`。
//! - `Menu` 没有 `append()`，每个 `MenuItem` 都要显式 `.parent(&menu)`。
//! - `TrayNotification::set_tip(&self, tip: &str)` **不接受 `Option`**。
//! - `Window` 只有 `minimize()`，**没有** `set_minimized(bool)`；从托盘恢复用
//!   `set_visible(true)`。
//! - `WindowCloseData::close(false)` 可以**取消**关闭 —— `close_to_tray` 靠它实现
//!   （`src\win32\window.rs:721-729` 的 `WM_CLOSE` 分支会看这个 bool）。
//! - `nwg::full_bind_event_handler` 收的是 **`Fn`**，不是 `FnMut`。所以事件处理器
//!   只能对捕获的东西取 `&self`。所有 nwg 的更新方法（`set_text` / `set_pos` /
//!   `set_visible`）都是 `&self`，所以把控件 `move` 进闭包就够了 ——
//!   这也是骨架里验证过的模式。

use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
use std::sync::{Arc, Condvar, Mutex};
use std::time::Duration;

use native_windows_gui as nwg;

use crate::hid::{self, HidDevice};
use crate::proto;
use crate::settings::{self, Settings};
use crate::snapshot::{self, FetchOutcome};
use crate::win32;

/// 托盘图标。**编进 exe**，不是运行时读文件。
///
/// 三个理由：绿色版是单文件发布（旁边不会有 `assets\`）、MSIX 里 exe 所在的
/// install 目录只读、`Icon::from_file` 在 strict=false 时读不到会 panic。
static TRAY_ICON: &[u8] = include_bytes!(concat!(env!("CARGO_MANIFEST_DIR"), "/assets/tray.ico"));

const WINDOW_TITLE: &str = "ROG 龙鳞 Ace Mini";

/// 刷新间隔的可选值（秒），与下拉框选项一一对应。
const REFRESH_CHOICES: [u64; 4] = [5, 15, 30, 60];
/// 缓存 TTL 的可选值（秒）。0 = 每次都重读设备。
const TTL_CHOICES: [u64; 4] = [0, 30, 60, 120];

/// Tab 页客户区的背景色。
///
/// nwg 的 `Label` 默认用 `COLOR_BTNFACE`（#F0F0F0）铺满自己的矩形，而 Tab 页
/// 的客户区是纯白（#FFFFFF）—— 结果每个标签都变成一块灰底方块，看起来像画坏的
/// 占位框。给每个 Label 显式指定白色背景，它们才融进页面。
const PAGE_BG: [u8; 3] = [255, 255, 255];

/// 曲线自绘用的子类过程 ID。**必须 > 0xFFFF** —— nwg 的
/// `bind_raw_event_handler` 对 ≤ 0xFFFF 的 id 直接 panic（那是它自己保留的段）。
const CHART_HANDLER_ID: usize = 0x00C4_0001;

// ==================== 后台线程 ↔ GUI 线程的交接 ====================

/// 一次轻量读取的结果，转成 UI 能直接用的形态。
#[derive(Clone)]
struct QuickData {
    level: u8,
    voltage_mv: u16,
    charging: bool,
    poll_code: u8,
    active_stage: u8,
}

impl QuickData {
    /// 电量那一行的文字，例如 `84%`。
    fn level_text(&self) -> String {
        format!("{}%", self.level)
    }

    /// 充电状态的人话。三态对用户的意义完全不同，不能只说「充电 0/1」。
    fn charge_text(&self) -> &'static str {
        if self.charging {
            "充电中"
        } else {
            "使用中"
        }
    }

    fn meta_text(&self) -> String {
        format!(
            "电压 {} mV  ·  {}  ·  回报率 {}  ·  当前档位 {}",
            self.voltage_mv,
            self.charge_text(),
            proto::poll_name(self.poll_code),
            self.active_stage
        )
    }
}

/// UI 的五态。`Asleep` 和 `Error` 必须分开 —— 前者是设备的正常状态，
/// 后者才需要用户动手排查。混成一句「失败」会让人瞎试，
/// 而这个程序瞎试意味着往 flash 里写东西。
enum Status {
    /// 还没读过。
    Idle,
    /// 读到了。
    Ok,
    /// 鼠标休眠 —— **不是错误**。
    Asleep,
    /// 正在写设备（一个 setter 约 1.4 秒）。期间按钮要置灰。
    Busy,
    /// 真出错了（设备没接、被独占、读失败）。
    Error(String),
}

impl Default for Status {
    fn default() -> Self {
        Status::Idle
    }
}

impl Status {
    /// `Busy` 时所有写入按钮都要禁用 —— 两次写交叉执行会写坏设备。
    fn is_busy(&self) -> bool {
        matches!(self, Status::Busy)
    }
}

// ==================== 写命令队列 ====================

/// GUI 线程 → 后台线程的一条写命令。
///
/// 每个变体都对应 [`crate::ops`] 里一个已经写好、单测过的函数。
/// **这里只做参数打包，不做任何校验** —— 校验在 `ops::*` 里，
/// 保证 CLI 和 GUI 走的是同一份判断（漏一处就是设备被写坏的那一处）。
#[derive(Clone)]
enum Cmd {
    Poll(i32),
    Dpi { stage: usize, dpi: i32, rgb: Option<[u8; 3]> },
    Stage(u8),
    Debounce(u8),
    Snap(u8),
    Tuning(i16),
    Lod(u8),
    /// 灯光。`dir` / `random` / `speed` 是灯光页「高级」折叠里的三个控件。
    ///
    /// 本型号只支持 Static / Breathing / ColorCycle / React / BatteryState / Off，
    /// 其中用到方向、随机、速度的是 Rainbow 与 Comet —— 而这两个设备会**静默回落**
    /// 到 ColorCycle（见 `proto::light_mode_supported` 与厂商 `IsLightingModeSupported()`）。
    /// 也就是说这三个值当前写下去不产生可见效果，但**必须照样写**：
    /// ① `ops::set_light` 的 `probe`/`expect` 会把它们纳入读回断言，不传就会
    ///    把设备上原有的非零值清零、且断言永不相等报 `applied=NO`；
    /// ② 将来换型号或厂商放开限制时，这三个控件已经是对的。
    Light {
        mode: u8,
        bright: Option<u8>,
        rgb: Option<[u8; 3]>,
        dir: Option<u8>,
        random: Option<u8>,
        speed: Option<u8>,
    },
    Button { slot: usize, dst: u16, confirmed: bool },
    /// 开机自启开关。`true` = 用户勾上，`false` = 用户取消。
    ///
    /// 放进同一个 `Cmd` 队列是为了绕开一个具体的坑：`autostart::enable()`
    /// 会同步等 WinRT / 注册表往返（`RoInitialize` + `RequestEnableAsync` 的
    /// 异步等待最坏要几百毫秒），在 GUI 线程上直接调会把窗口卡住 ——
    /// 而且 `enable()` 内部还要读注册表回读验证。所以和其他写命令一样
    /// 丢给后台线程，`Busy` 期间按钮一并禁用（防连点交叉写）。
    AutoStart(bool),
}

impl Cmd {
    /// 给界面看的短名，用来拼「正在写：xxx」这类提示。
    fn label(&self) -> String {
        match self {
            Cmd::Poll(hz) => format!("回报率 {hz} Hz"),
            Cmd::Dpi { stage, dpi, .. } => format!("DPI 档 {stage} → {dpi}"),
            Cmd::Stage(s) => format!("当前档位 {s}"),
            Cmd::Debounce(c) => format!("去抖 {c}"),
            Cmd::Snap(v) => format!("角度吸附 {v}"),
            Cmd::Tuning(v) => format!("角度微调 {v}"),
            Cmd::Lod(v) => format!("抬起距离 {}", if *v == 0 { "Low" } else { "High" }),
            Cmd::Light { mode, .. } => format!("灯光 {}", proto::light_mode_name(*mode)),
            Cmd::Button { slot, dst, .. } => format!("按键槽 {slot} → 0x{dst:04X}"),
            Cmd::AutoStart(on) => {
                format!("开机自启 {}", if *on { "开启" } else { "关闭" })
            }
        }
    }
}

/// 一条写命令的结局，回到 GUI 线程后显示在页面上。
struct CmdResult {
    label: String,
    /// 成功时的摘要（来自 [`crate::ops::ApplyReport::summary`]）。
    ok: Option<String>,
    /// 附加提示（口径不一致的 DPI、会重置标定等）。
    warning: Option<String>,
    /// 失败原因。`kind` 决定要不要提示「鼠标休眠中」。
    err: Option<(crate::ops::ErrorKind, String)>,
    /// 自启命令**回读**到的真实状态（只有 `Cmd::AutoStart` 会填）。
    ///
    /// 界面拿它去改勾选框 —— 这不属于「成功/失败」，
    /// 因为「操作成功但状态没变」也是一种要正确显示的情况。
    auto: Option<(crate::autostart::AutoStartState, crate::autostart::AutoStartPath)>,
}

/// 从 `Shared` 里抄出来给渲染用的只读快照。
///
/// `CmdResult` 里有 `ErrorKind`（`Copy`）和一堆 `String`，
/// 直接 clone 比在持锁状态下渲染安全 —— 渲染会调 Win32，不该握着锁。
struct CmdEcho {
    label: String,
    ok: Option<String>,
    warning: Option<String>,
    err: Option<(crate::ops::ErrorKind, String)>,
    /// 自启命令回读到的真实状态（见 [`CmdResult::auto`]）。
    auto: Option<(crate::autostart::AutoStartState, crate::autostart::AutoStartPath)>,
}

/// 性能页里需要被 `render_perf` 更新的那批「当前值」控件。
struct PerfUi {
    poll_now: nwg::Label,
    dpi_now: Vec<nwg::Label>,
    stage_now: nwg::Label,
    deb_now: nwg::Label,
    snap_now: nwg::Label,
    tune_now: nwg::Label,
    lod_now: nwg::Label,
}

/// 灯光页的「当前值」控件。
struct LightUi {
    mode_now: nwg::Label,
    bright_now: nwg::Label,
    rgb_now: nwg::Label,
}


/// 后台线程 / GUI 线程共享的全部可变状态。
#[derive(Default)]
struct Shared {
    data: Option<QuickData>,
    /// 从 17 帧快照解析出来的**完整**状态。性能/灯光/按键三页要用。
    ///
    /// 与 `data` 分开是因为：`data` 来自 3 帧轻量读取（`fetch_light`），
    /// 而三页 UI 需要 DPI 四档颜色、按键表这些只有全量读取才有的字段。
    /// 两个都留着 —— 电量页每 15 秒刷一次只要 95ms，没必要为了它读 17 帧。
    full: Option<proto::State>,
    status: Status,
    /// 这次读是缓存命中还是真读了设备。
    from_cache: bool,
    /// 真读设备时的耗时（毫秒）；缓存命中时是 0。
    elapsed_ms: u128,
    /// `close_to_tray` 的当前值。放这里是因为事件处理器要读它，
    /// 而事件处理器是 `Fn`，读不了被 move 进它自己的控件状态。
    close_to_tray: bool,
    /// 托盘是否启用（同上，事件处理器要用）。
    tray_enabled: bool,
    /// 待执行的写命令。`Some` 表示后台线程还有活没干。
    pending: Option<Cmd>,
    /// 上一条命令的结局，显示在对应页面上。
    last_result: Option<CmdResult>,
    /// 下一次读取要不要读全量 17 帧。
    ///
    /// 三个触发点：启动时（三页要立刻有值）、切到性能/灯光/按键页时、
    /// 用户点「立即刷新」。其余时间走 3 帧轻量读取 —— 3 帧 95ms、
    /// 17 帧 590ms，差 6 倍，周期刷新用全量会有肉眼可见的迟滞感。
    want_full: bool,
    /// 历史曲线的**已算好的**点集。`WM_PAINT` 只读它，绝不在这里读盘。
    ///
    /// `None` 表示后台线程还没读完第一遍。此时 `WM_PAINT` 画「正在读取历史…」
    /// 而不是「样本不足」—— 后者会骗人（文件里明明有 7 条）。
    plot: Option<crate::chart::Plot>,
}

/// 后台线程的“马上刷一次”信号。
///
/// 用 `Condvar` 而不是轮询：用户点「立即刷新」时不该等满一个 interval。
/// 第三个字段是间隔（毫秒），改设置时由 GUI 线程写、后台线程每轮重读。
struct Signal {
    /// 递增的“请求序号”。后台线程记着上次处理到哪一号。
    poke: Mutex<u64>,
    cv: Condvar,
    interval_ms: AtomicU64,
    shutdown: AtomicBool,
}

impl Signal {
    fn new(interval_sec: u64) -> Self {
        Signal {
            poke: Mutex::new(0),
            cv: Condvar::new(),
            interval_ms: AtomicU64::new(interval_sec.saturating_mul(1000)),
            shutdown: AtomicBool::new(false),
        }
    }

    /// GUI 线程调：请立刻刷新一次。
    fn request_refresh(&self) {
        if let Ok(mut g) = self.poke.lock() {
            *g = g.wrapping_add(1);
        }
        self.cv.notify_all();
    }

    /// 后台线程调：等到「该动手了」。
    ///
    /// 返回 `false` 表示该退出了。
    ///
    /// `seen` 是调用方记的「已处理到哪一号请求」，由本函数自己推进 ——
    /// 放在调用方会被下一轮循环冲掉。
    fn wait_for_work(&self, seen: &mut u64) -> bool {
        loop {
            if self.shutdown.load(Ordering::Relaxed) {
                return false;
            }
            let ms = self.interval_ms.load(Ordering::Relaxed).max(1000);
            let g = match self.poke.lock() {
                Ok(g) => g,
                Err(p) => p.into_inner(),
            };
            // 上一轮之后有人点过「立即刷新」→ 不睡，马上干活
            if *g != *seen {
                *seen = *g;
                return true;
            }
            // 超时到期 = 常规轮询刷新
            let (g, timeout) = match self.cv.wait_timeout(g, Duration::from_millis(ms)) {
                Ok(v) => v,
                Err(p) => p.into_inner(),
            };
            let poked = *g != *seen;
            let timed_out = timeout.timed_out();
            if poked {
                *seen = *g;
            }
            drop(g);
            if self.shutdown.load(Ordering::Relaxed) {
                return false;
            }
            if poked || timed_out {
                return true;
            }
        }
    }
}

// ==================== 入口 ====================

/// GUI 主入口。
///
/// 调用前控制台已经被 [`crate::win32::FreeConsole`] 脱离干净，
/// **这里不能有任何 `println!`** —— 没有东西会接住它。
pub fn run() -> Result<(), String> {
    nwg::init().map_err(|e| format!("初始化 GUI 失败：{e}"))?;

    // 中文字体：不设也能显示，设了更整齐。失败不是致命错误。
    //
    // 但**不能把错误吞掉**：`set_global_family` 只在 `CreateFontW` 返回空句柄时
    // 报错，那时 nwg 会把全局默认字体留成 `None`，所有控件退到系统 DEFAULT_GUI_FONT
    // —— 中文能显示，但字形和字号在整套界面上是乱的。
    //
    // 所以按「雅黑 → 宋体 → 放弃」三级回落：宋体（SimSun）在任何中文 Windows 上
    // 都有（本机 `C:\Windows\Fonts\simsun.ttc` 18.1 MB 实测存在）。
    // 连宋体都建不出来就只能放弃，交给 nwg 的默认字体。
    if nwg::Font::set_global_family("Microsoft YaHei UI").is_err()
        && nwg::Font::set_global_family("SimSun").is_err()
    {
        // 两种中文字体都建不出来（理论上不会发生）。保持 nwg 默认字体。
    }

    let cfg = settings::load();

    // ── 主窗口 ──────────────────────────────────────────────
    let mut window = nwg::Window::default();
    nwg::Window::builder()
        .size((780, 580))
        .center(true)
        .title(WINDOW_TITLE)
        .build(&mut window)
        .map_err(|e| format!("建主窗口失败：{e}"))?;

    // ── 分页容器 ────────────────────────────────────────────
    // 高度必须给够（坑：给 60 会导致标签条完全不渲染）
    let mut tabs = nwg::TabsContainer::default();
    nwg::TabsContainer::builder()
        .parent(&window)
        .position((12, 12))
        .size((740, 520))
        .build(&mut tabs)
        .map_err(|e| format!("建标签容器失败：{e}"))?;

    let tab_names = ["电量", "性能", "灯光", "按键", "设置"];
    let mut pages: Vec<nwg::Tab> = Vec::new();
    for name in tab_names {
        let mut t = nwg::Tab::default();
        nwg::Tab::builder()
            .text(name)
            .parent(&tabs)
            .build(&mut t)
            .map_err(|e| format!("建标签页 {name} 失败：{e}"))?;
        pages.push(t);
    }

    // ── 电量页（tab 0）──────────────────────────────────────
    // 坐标相对 Tab 客户区，左上角约 (4, 26) 起（标签条下方）
    let page_bat = &pages[0];

    let mut lbl_level = nwg::Label::default();
    nwg::Label::builder()
        .text("电量")
        .parent(page_bat)
        .position((24, 28))
        .size((48, 26))
        .background_color(Some(PAGE_BG))
        .build(&mut lbl_level)
        .map_err(|e| format!("电量标签：{e}"))?;

    let mut pb_level = nwg::ProgressBar::default();
    nwg::ProgressBar::builder()
        .parent(page_bat)
        .position((80, 30))
        .size((400, 22))
        .range(0..100)
        .pos(0)
        .build(&mut pb_level)
        .map_err(|e| format!("电量进度条：{e}"))?;

    let mut lbl_level_text = nwg::Label::default();
    nwg::Label::builder()
        .text("--%")
        .parent(page_bat)
        .position((496, 28))
        .size((160, 26))
        .background_color(Some(PAGE_BG))
        .build(&mut lbl_level_text)
        .map_err(|e| format!("电量文字：{e}"))?;

    let mut lbl_status = nwg::Label::default();
